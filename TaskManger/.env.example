# Docker Compose development template. Copy to .env; never commit .env.
# The credentials below are PUBLIC, local-only placeholders, not real secrets.
# For host-based development, use the localhost exports in README.md instead.

# Django: use a new random secret and DEBUG=false for production.
DEBUG=true
SECRET_KEY=local-only-taskflow-development-secret
PUBLIC_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: these placeholders must agree with DATABASE_URL.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://taskflow:local-development-only@db:5432/taskflow
REDIS_URL=redis://redis:6379/0

# Mailpit captures local mail. Put real SMTP credentials only in private .env.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=TaskFlow <noreply@taskflow.local>

# SMS: mock is development-only; choose disabled or twilio in production.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Enable only behind a trusted proxy that overwrites forwarded headers.
TRUST_PROXY_HTTPS=false
