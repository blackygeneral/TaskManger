# Local configuration and credentials; safe templates stay versioned.
.env
.env.*
!.env.example
!.env.*.example
*.local
*.pem
*.key
*.p12
*.pfx
.aws/
.codex/
.agents/

# Python environments, bytecode, packaging and tool caches.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Django runtime state and user data (never delete these as source cleanup).
*.sqlite3
*.sqlite3-*
*.db
*.db-journal
*.db-shm
*.db-wal
staticfiles/
media/
uploads/
backups/
*.dump
*.sql.gz
celerybeat-schedule*
celerybeat.pid

# JavaScript dependencies and generated output; package-lock.json is required.
node_modules/
dist/
dist-ssr/
build/
.vite/
.vite-temp/
*.tsbuildinfo
.eslintcache
coverage/

# Browser-test artifacts may include cookies, screenshots and local data.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs, temporary files and editor/OS settings.
logs/
*.log
*.log.*
*.pid
*.pid.lock
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
